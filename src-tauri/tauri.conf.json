{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Q-GUI",
  "version": "1.0.0",
  "identifier": "com.zyhcs.qgui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Q-GUI (极龟)",
        "url": "index.html",
        "width": 860,
        "height": 640,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "center": true
      },
      {
        "label": "hud",
        "title": "Q-GUI Mini HUD",
        "url": "index.html?window=hud",
        "width": 620,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
